# Router admin login (the "user" account works).
ROUTER_HOST=192.168.1.1
ROUTER_USER=user
ROUTER_PASS=change-me

# Spare Wi-Fi slot for neighbors. Slot 1 is your main Wi-Fi and is never changed.
SLOT_INDEX=2
SLOT_SSID=Jirani-1

# Password for the admin pages of this app.
ADMIN_PASS=change-me

# Time zone for the times on the pages, and the currency of the prices.
TIMEZONE=Africa/Kampala
CURRENCY=UGX
